#!/usr/bin/env bash
# fiddy — three commands to your own Farcaster client on your own Snapchain node.
#
#   fiddy provision   # (0) provision compute (AWS, or register any server over SSH)
#   fiddy node up     # (1) install + sync a Snapchain read node on that compute
#   fiddy client up   # (2) run the Fiddy client pointed at your node
#
# No API keys from anyone. You furnish the compute; the node syncs the network.
set -euo pipefail

FIDDY_HOME="${FIDDY_HOME:-$HOME/.fiddy}"
FIDDY_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export FIDDY_HOME FIDDY_REPO

source "$FIDDY_REPO/cli/lib/common.sh"
bash_ok

usage() {
  cat <<'EOF'
fiddy — your own Farcaster client on your own node.

Usage: fiddy <command> [options]

  provision   Provision compute for your node
              --aws                       create an AWS EC2 instance (needs aws CLI)
              --ssh user@host             use any server you already have
  node        Manage your Snapchain read node
              up                          check sizing, install, start, wait for sync
              status                      is it working? (/v1/info in plain words)
              logs                        tail node logs
              stop | start | upgrade      wrap snapchain.sh on the remote
  client      Run the Fiddy client against your node
              up [--tunnel] [--build]     dev server, SSH tunnel, or prod build
  doctor      Check local prerequisites (and whether --local is even possible)
  config      Show current fiddy configuration

Run it as `bash bin/fiddy …`, or put bin/ on your PATH:
  export PATH="$PWD/bin:$PATH"
Runs on macOS's bash 3.2 as well as bash 4/5.

Docs: https://fiddy.fun/client
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  provision) source "$FIDDY_REPO/cli/provision.sh"; provision_main "$@" ;;
  node)      source "$FIDDY_REPO/cli/node.sh";      node_main "$@" ;;
  client)    source "$FIDDY_REPO/cli/client.sh";    client_main "$@" ;;
  doctor)    source "$FIDDY_REPO/cli/doctor.sh";    doctor_main "$@" ;;
  config)    config_load; config_show ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (try: fiddy --help)" ;;
esac
