#!/usr/bin/env bash
# fiddy — three commands to your own Farcaster client on your own Snapchain node.
#
#   fiddy provision   # (0) provision compute (AWS, or register any server over SSH)
#   fiddy node up     # (1) install + sync a Snapchain read node on that compute
#   fiddy client up   # (2) run the Fiddy client pointed at your node
#
# No API keys from anyone. You furnish the compute; the node syncs the network.
set -euo pipefail

[ -n "${BASH_VERSION:-}" ] || { echo "fiddy needs bash (bash bin/fiddy …)" >&2; exit 1; }

FIDDY_HOME="${FIDDY_HOME:-$HOME/.fiddy}"
# Resolve symlinks (e.g. /usr/local/bin/fiddy → repo/bin/fiddy) so FIDDY_REPO
# is the real checkout, not the symlink's directory.
FIDDY_SRC="${BASH_SOURCE[0]}"
while [ -L "$FIDDY_SRC" ]; do
  FIDDY_DIR="$(cd -P "$(dirname "$FIDDY_SRC")" && pwd)"
  FIDDY_SRC="$(readlink "$FIDDY_SRC")"
  case "$FIDDY_SRC" in /*) ;; *) FIDDY_SRC="$FIDDY_DIR/$FIDDY_SRC" ;; esac
done
FIDDY_REPO="$(cd -P "$(dirname "$FIDDY_SRC")/.." && pwd)"
export FIDDY_HOME FIDDY_REPO

source "$FIDDY_REPO/cli/lib/common.sh"

usage() {
  cat <<'EOF'
fiddy — your own Farcaster client on your own node.

Usage: fiddy <command> [options]

  provision   Provision compute for your node
              --aws                       create an AWS EC2 instance (needs aws CLI)
              --ssh user@host             use any server you already have
  node        Manage your Snapchain read node
              up [--local] [--force]      install + start + wait for the API
              status                      sync status and health
              logs                        tail node logs
              start | stop | upgrade      lifecycle without the log tail
  client      Run the Fiddy client
              up [--tunnel] [--build]     dev server, SSH tunnel, or prod build
              check                       where the client's reads go today
  doctor      Check local prerequisites
  install     Put `fiddy` on PATH permanently (symlink into /usr/local/bin)
  config      Show current fiddy configuration

A mainnet read node needs 4 vCPU, 16 GB RAM and 1.5 TB free disk (snapshot
bootstrap needs scratch on top of that). fiddy checks the target first and
will not fill a machine that cannot host it; --force overrides the check.

Docs: https://fiddy.fun/client
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  provision) source "$FIDDY_REPO/cli/provision.sh"; provision_main "$@" ;;
  node)      source "$FIDDY_REPO/cli/node.sh";      node_main "$@" ;;
  client)    source "$FIDDY_REPO/cli/client.sh";    client_main "$@" ;;
  doctor)    source "$FIDDY_REPO/cli/doctor.sh";    doctor_main "$@" ;;
  install)
    target=/usr/local/bin/fiddy
    if [ -w /usr/local/bin ] 2>/dev/null; then
      ln -sf "$FIDDY_REPO/bin/fiddy" "$target"
    elif command -v sudo >/dev/null 2>&1; then
      sudo ln -sf "$FIDDY_REPO/bin/fiddy" "$target"
    else
      die "need sudo to write $target — run: sudo ln -sf $FIDDY_REPO/bin/fiddy $target"
    fi
    ok "installed: $target → $FIDDY_REPO/bin/fiddy (every new shell finds \`fiddy\` now)"
    ;;
  config)    config_load; config_show ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (try: fiddy --help)" ;;
esac
